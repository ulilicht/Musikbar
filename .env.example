# Music Assistant Server Configuration
# Copy this file to .env.local and adjust your settings:
MUSIC_ASSISTANT_URL=http://<your-music-assistant-host>:8095
# Optional LAN URL for direct doc introspection if reverse proxy blocks /api-docs/* subpaths:
MUSIC_ASSISTANT_LOCAL_URL=http://<your-music-assistant-lan-ip>:8095
MUSIC_ASSISTANT_TOKEN=your_long_lived_token_here
